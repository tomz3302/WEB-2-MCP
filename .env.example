# ── LLM provider ──────────────────────────────────────────────────────────────
# OpenAI (default) – required when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic – required when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=ant-your-anthropic-api-key

# ── LLM model settings ────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Use a custom OpenAI-compatible base URL (e.g. for local proxies / LM Studio)
# OPENAI_BASE_URL=http://localhost:1234/v1

# ── Browser settings ──────────────────────────────────────────────────────────
# Set to 'false' to open a visible browser window during development
BROWSER_HEADLESS=true

# Timeout in milliseconds for page-load and selector waits
BROWSER_TIMEOUT=30000

# Maximum number of steps the browser-use agent may take per task
MAX_BROWSER_STEPS=50

# ── MCP server ────────────────────────────────────────────────────────────────
MCP_SERVER_NAME=WEB-2-MCP
